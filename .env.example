# Application Environment (dev | prod)
ENV=dev

# Session Secret Key (Must be set to a strong random value in production)
SECRET_KEY=change-this-in-production-use-a-strong-secret-key

# Database Connection URL (SQLite by default, can be PostgreSQL later)
DATABASE_URL=sqlite:///./app.db

# Feature Flags
FEATURE_ACCOUNTS=true
FEATURE_SOIL=true

